@page "/orders"
@using ECommerce.Web.Services
@inject OrderingApiClient Ordering
@rendermode InteractiveServer

<PageTitle>Orders</PageTitle>

<h1>Orders</h1>

<button class="btn btn-ghost mb-4" @onclick="Load">Refresh orders</button>

@if (_orders is null)
{
    <div role="status" aria-live="polite">
        <span class="visually-hidden">Loading orders…</span>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
    </div>
}
else if (_orders.Count == 0)
{
    <p class="notice">No orders yet. Add products from the <a href="/products">catalog</a> to place one.</p>
}
else
{
    @foreach (var order in _orders)
    {
        <section class="order" aria-labelledby="order-@order.Id">
            <div class="order-head">
                <h2 id="order-@order.Id">Order #@order.Id for @order.Customer</h2>
                <span class="status">@order.Status</span>
            </div>
            <p class="order-meta">Placed @order.CreatedAt.LocalDateTime</p>
            <table>
                <caption class="visually-hidden">Items in order #@order.Id</caption>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.Quantity × @item.ProductName</td>
                            <td>@item.UnitPrice.ToString("C") each</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>Total</td>
                        <td>@order.Total.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </section>
    }
}

@code {
    private IReadOnlyList<OrderDto>? _orders;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _orders = null;
        _orders = await Ordering.GetOrdersAsync();
    }
}
